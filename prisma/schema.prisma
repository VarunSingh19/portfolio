generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Blog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  author          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  image_public_id String
  content         String
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
